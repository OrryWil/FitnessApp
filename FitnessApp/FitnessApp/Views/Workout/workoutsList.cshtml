@model List<FitnessApp.Models.WorkoutInfo>


<h4>Athletes:</h4>
<table class="table">
    <thead>
        <tr>
            <th>Workout Name</th>
            <th>assigned to</th>
            <th>not completed yet</th>
            <th>View Workout</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var WorkoutInfo in Model)
        {
            <tr>
                <td>@WorkoutInfo.workoutname</td>
               
                <td>
                    @foreach (var workAssignment in WorkoutInfo.workoutassignments)
                    {
                        @workAssignment.athlete.firstname @workAssignment.athlete.lastname
                    }
                </td>
                <td>
                    @foreach (var workAssignment in WorkoutInfo.workoutassignments)
                    {
                        @if(!workAssignment.workoutresults.All(r => r.completed))
                        {
                            
                            @workAssignment.athlete.firstname
                            @workAssignment.athlete.lastname
                            
                        }
                     }
                </td>
                <td></td>
            </tr>
        }
    </tbody>
</table>

