@model List<FitnessApp.Models.Exercises>
@{
    ViewData["Title"] = "Exercises Index";
}

<h3>Exercises</h3>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exercise in Model)
        {
            <tr>
                <td>@exercise.exercisename</td>
                <td>@exercise.description</td>
                <td></td>
            </tr>
        }
    </tbody>
