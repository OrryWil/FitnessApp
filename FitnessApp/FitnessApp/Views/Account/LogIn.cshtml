@model FitnessApp.Models.Coaches
@{
    Layout = null;

    ViewData["Title"] = "Log In";
}
<h1>@ViewData["Title"]</h1>

<form method="post">
    <input type="radio" id="Coach" name="title" value="Coach"/>
    <label for="Coach">Coach</label><br />
    <input type="radio" id="Athlete" name="title" value="Athlete" />
    <label for="Athlete">Athlete</label><br />
    <label for="Email">Email:</label><br />
    <input type="text" asp-for="email" /><br />
    <label for="Password">Password:</label><br />
    <input type="password" asp-for="passwordhash" /><br />
    <Button type="submit">Login</Button>
</form>
